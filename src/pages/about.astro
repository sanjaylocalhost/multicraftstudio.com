---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const members = [
  { letter: '01', title: 'Digital & media', text: 'Websites, SEO, mobile apps, e-commerce, video production and graphic design.' },
  { letter: '02', title: 'Engineering & 3D', text: 'Civil, mechanical and electrical drawings, CAD drafting, modeling and visualization.' },
  { letter: '03', title: 'Social & content', text: 'Social media management, content planning and digital content creation.' },
];
---
<BaseLayout title="About the Studio | MultiCraft Studio" description="Meet the three areas of expertise behind MultiCraft Studio, a collaborative freelance team." currentPath="/about/">
  <Header currentPath="/about/" />
  <main class="wrap"><section class="page-hero"><span class="eyebrow">A little about us</span><h1>Different skills.<br /><em>Shared purpose.</em></h1><p>MultiCraft Studio is a small freelance team bringing digital, engineering and creative work together. We stay close to the details and keep the conversation straightforward.</p><div class="about-band"><h2>Built around collaboration.</h2><p>Some projects need one specialist; others benefit from a few disciplines working together. We’ll be clear about who is doing what, what’s included and what information we need from you.</p></div></section><section class="section" aria-labelledby="team-title"><div class="section-heading"><div><span class="eyebrow">The studio</span><h2 id="team-title">Three people, connected skills.</h2></div></div><div class="team-row">{members.map(member=><article class="team-card"><div class="team-avatar" aria-hidden="true">{member.letter}</div><h3>{member.title}</h3><p>{member.text}</p></article>)}</div><p class="placeholder-note">Add team members’ names, photos, locations and experience here when you’re ready.</p></section></main>
  <Footer />
</BaseLayout>